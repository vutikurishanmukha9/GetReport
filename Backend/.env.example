# Primary Recommended LLM Provider: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Alternative LLM Providers
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# TypeSafe AI: Jev System One Model for rapid structured decisions (<200ms)
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_MODEL=jev-latest

# Security: API key authentication is required by default.
API_KEY=replace-with-a-long-random-value
REQUIRE_AUTH=true
# Use REQUIRE_AUTH=false only for isolated local development.
# Snowflake vault encryption key; required when DATABASE_URL or REDIS_URL is configured.
SECRET_KEY=replace-with-a-different-long-random-value

# Database: PostgreSQL connection string (leave empty for SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis: Use authenticated URL in production
# REDIS_URL=rediss://:your-redis-password@host:6379/0

# CORS: Comma-separated allowed origins (restrict in production)
# CORS_ORIGINS=https://your-domain.com

# Storage (local | db | s3)
# local: Saves files to disk (default).
# db: Stores files in DB as BLOB/BYTEA. Use on Render to share files between workers.
# s3: AWS S3 generic standard.
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_BUCKET_NAME=getreport-uploads
